# Copy this file to .env and fill in your real local values.
# .env is gitignored — it's never committed, unlike this example file.

DATABASE_URL=postgres://postgres:YOUR_PASSWORD_HERE@localhost:5432/startrack?sslmode=disable
JWT_SECRET=dev-only-change-me
S3_BUCKET=startrack-assets
S3_REGION=us-east-1
