# Copy this file to .env and fill in your real local values.
# .env is gitignored — it's never committed, unlike this example file.

DATABASE_URL=postgres://postgres:YOUR_PASSWORD_HERE@localhost:5432/startrack?sslmode=disable
JWT_SECRET=dev-only-change-me
S3_BUCKET=startrack-assets
S3_REGION=us-east-1
# PORT=8081

# Optional — password reset codes are emailed via SMTP when these are set.
# Without them, the reset email is just logged to the server console
# instead (dev fallback; the code is never returned in the API response).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=you@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=StarTrack <no-reply@startrack.app>
